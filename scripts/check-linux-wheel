#!/usr/bin/env python3
"""Test release archives and wheels in clean native AlmaLinux 8 runtime images."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import shutil
import subprocess
import tarfile
import tempfile
import zipfile

from release import standalone_members, wheel_identity, wheel_permissions

ROOT = Path(__file__).resolve().parent.parent


def verify_archive(wheel: Path, archive: Path, target: str) -> None:
    version, _ = wheel_identity(wheel)
    with zipfile.ZipFile(wheel) as dist, tarfile.open(archive, "r:gz") as bundle:
        expected = standalone_members(dist, version, target)
        for member in bundle:
            # The builder leaves directories implicit. An explicit directory
            # could restrict access to files whose own permissions match.
            source = expected.pop(member.name, None)
            if source is None:
                raise SystemExit(f"unexpected archive member: {member.name}")
            if not member.isfile():
                raise SystemExit(f"archive {member.name} must be a regular file")
            entry = dist.getinfo(source)
            mode = wheel_permissions(entry)
            if member.mode != mode:
                raise SystemExit(
                    f"archive {member.name} has mode {member.mode:04o}, expected {mode:04o}"
                )
            with dist.open(entry) as original, bundle.extractfile(member) as archived:
                wheel_hash = hashlib.file_digest(original, "sha256").digest()
                if hashlib.file_digest(archived, "sha256").digest() != wheel_hash:
                    raise SystemExit(f"archive {member.name} differs from the wheel")
        if expected:
            raise SystemExit(f"missing archive member: {', '.join(sorted(expected))}")


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("wheel", type=Path)
    parser.add_argument("--archive", type=Path, required=True)
    parser.add_argument(
        "--target",
        required=True,
        choices=("x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu"),
    )
    parser.add_argument("--evidence", type=Path, required=True)
    parser.add_argument("--docker-context")
    args = parser.parse_args()
    wheel = args.wheel.resolve()
    archive = args.archive.resolve()
    assert wheel.is_file() and archive.is_file()
    evidence = args.evidence.resolve()
    evidence.parent.mkdir(parents=True, exist_ok=True)
    docker = [
        "docker",
        *(["--context", args.docker_context] if args.docker_context else []),
    ]
    # Keep bind inputs beside evidence, on the filesystem shared with the daemon.
    with tempfile.TemporaryDirectory(
        prefix="mcp-console-linux-floor-", dir=evidence.parent
    ) as directory:
        inputs = Path(directory)
        # Only the artifact and minimal public smoke/installation harness enter.
        for source, destination in (
            (wheel, inputs / wheel.name),
            (archive, inputs / archive.name),
            (ROOT / "scripts/linux-wheel/standalone.sh", inputs / "standalone.sh"),
            (ROOT / "scripts/linux-wheel/Dockerfile", inputs / "Dockerfile"),
            (ROOT / "scripts/configure-ci-r.R", inputs / "configure-ci-r.R"),
            (ROOT / "scripts/release.py", inputs / "release.py"),
            (ROOT / "sandbox-runner.json", inputs / "sandbox-runner.json"),
            (ROOT / "tests/linux_wheel_runtime.py", inputs / "linux_wheel_runtime.py"),
            (
                ROOT / "tests/sandbox_installation.py",
                inputs / "sandbox_installation.py",
            ),
            (ROOT / "tests/support/native.py", inputs / "support/native.py"),
        ):
            destination.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(source, destination)

        verify_archive(inputs / wheel.name, inputs / archive.name, args.target)
        architecture = args.target.split("-", 1)[0]
        daemon_architecture = subprocess.check_output(
            [*docker, "info", "--format", "{{.Architecture}}"], text=True
        ).strip()
        assert daemon_architecture == architecture, (
            "floor validation requires a matching native Docker host"
        )
        for image in ("almalinux:8-minimal", "ghcr.io/astral-sh/uv:0.13.1"):
            subprocess.run([*docker, "pull", image], check=True)
        # The no-R image runs inspect-wheel --release against the checkout's pin
        # before launching anything from the wheel or its matching archive.
        for mode in ("no-r", "standalone", "with-r"):
            output = evidence / mode
            output.mkdir(parents=True, exist_ok=True)
            image = f"mcp-console-linux-floor:{inputs.name}-{mode}"
            subprocess.run(
                [
                    *docker,
                    "build",
                    "--target",
                    mode,
                    "--tag",
                    image,
                    *(
                        ["--build-arg", f"R_PREPARATION_RUN={inputs.name}"]
                        if mode == "with-r"
                        else []
                    ),
                    str(inputs),
                ],
                check=True,
            )
            images = subprocess.check_output(
                [
                    *docker,
                    "image",
                    "inspect",
                    "almalinux:8-minimal",
                    "ghcr.io/astral-sh/uv:0.13.1",
                    image,
                ],
                text=True,
            )
            (output / "images.json").write_text(images, encoding="utf-8")
            command = [
                *docker,
                "run",
                "--rm",
                "--cap-add",
                "SYS_ADMIN",
                "--security-opt",
                "seccomp=unconfined",
                "--security-opt",
                "apparmor=unconfined",
                "--mount",
                f"type=bind,src={inputs},dst=/test,readonly",
                "--mount",
                f"type=bind,src={output},dst=/evidence",
                image,
            ]
            if mode == "standalone":
                command += ["sh", "/test/standalone.sh", f"/test/{archive.name}"]
            else:
                command += [
                    "python3",
                    "/test/linux_wheel_runtime.py",
                    f"/test/{wheel.name}",
                    "--target",
                    args.target,
                    *(["--with-r"] if mode == "with-r" else []),
                ]
            (output / "command.json").write_text(json.dumps(command), encoding="utf-8")
            subprocess.run(command, check=True)


if __name__ == "__main__":
    main()
