#!/usr/bin/env python3
"""Run every formatter, reporting failures; --strict also fails the command."""

import argparse
import os
from pathlib import Path
import shutil
import subprocess

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--strict", action="store_true")
options = parser.parse_args()
os.chdir(Path(__file__).resolve().parent.parent)
failed = False
for name, command in (
    (
        "ruff",
        [
            "ruff",
            "format",
            ".",
            *sorted(
                str(path)
                for path in Path("scripts").iterdir()
                if path.is_file() and not path.suffix
            ),
        ],
    ),
    ("yamark", ["yamark", "format", "--wrap", "sentence"]),
    ("rustfmt", ["cargo", "fmt", "--all"]),
    ("air", ["air", "format", "."]),
):
    try:
        status = subprocess.call([shutil.which(command[0]) or command[0], *command[1:]])
    except OSError as error:
        print(f"{name}: {error}")
        status = 127
    print(f"{name}: failed ({status})" if status else f"{name}: ok", flush=True)
    failed |= bool(status)
raise SystemExit(int(failed and options.strict))
