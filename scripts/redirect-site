#!/usr/bin/env python3
"""Turn the personal repository's rendered website into migration redirects."""

import argparse
from html import escape
from pathlib import Path
from urllib.parse import quote

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("site", type=Path, help="Rendered website directory")
site = parser.parse_args().site
assert (site / "index.html").is_file(), "Render the website before converting it"

# Keep every published HTML path and all downloadable assets. The custom 404
# forwards links to pages added at the new site after this repository is frozen.
pages = sorted(set(site.rglob("*.html")) | {site / "404.html"})
for page in pages:
    route = page.relative_to(site).as_posix()
    if page.name == "index.html":
        route = route.removesuffix("index.html")
    if route == "404.html":
        route = ""
    target = escape("https://posit-dev.github.io/mcp-console/" + quote(route))
    page.write_text(
        f"""<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>MCP Console documentation has moved</title>
  <link rel="canonical" href="{target}">
</head>
<body>
  <h1>Documentation has moved</h1>
  <p>Continue to <a id="destination" href="{target}">MCP Console documentation</a>.</p>
  <noscript><p>Follow the link above to open the new website.</p></noscript>
  <script>
    const target = new URL("https://posit-dev.github.io");
    target.pathname = window.location.pathname;
    target.search = window.location.search;
    target.hash = window.location.hash;
    document.getElementById("destination").href = target.href;
    window.location.replace(target.href);
  </script>
</body>
</html>
""",
        encoding="utf-8",
    )

print(f"Wrote {len(pages)} migration redirect pages in {site}")
