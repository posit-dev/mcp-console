#!/usr/bin/env -S uv run --no-project --isolated --with-requirements docs/requirements.txt python
"""Render the complete documentation website from the repository root."""

import os
import sys

os.environ["QUARTO_PYTHON"] = sys.executable
os.execvp(
    "quarto",
    ["quarto", "render", "docs", "--to", "html", *sys.argv[1:]],
)
