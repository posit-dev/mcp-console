#!/usr/bin/env python3
import os
from pathlib import Path
import runpy
import sys

root = Path(__file__).resolve().parent.parent
os.chdir(root)
if sys.platform == "win32":
    runpy.run_path(str(root / "tests/windows_runner.py"), run_name="__main__")
else:
    os.execv(
        sys.executable,
        [
            sys.executable,
            str(root / "tests/boundaries/_run.py"),
            "--bootstrap",
            "--build",
            *sys.argv[1:],
        ],
    )
