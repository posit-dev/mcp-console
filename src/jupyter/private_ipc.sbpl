
; Jupyter kernels and their adapter share the runner's disposable storage.
; The runner supplies this parameter after creating that private directory.
; Path matching follows symlinks: a link to a host socket is not an exception.
; TCP, host Unix sockets, and host filesystem writes retain their base policy.
(allow system-socket (socket-domain AF_UNIX))
(allow network-bind
  (local unix-socket (subpath (param "RUNNER_PRIVATE_DATA"))))
(allow network-outbound
  (remote unix-socket (subpath (param "RUNNER_PRIVATE_DATA"))))
