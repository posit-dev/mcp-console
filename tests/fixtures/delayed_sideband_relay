#!/bin/sh
set -eu

: "${MCP_CONSOLE_TEST_RELAY_BINARY:?}"
: "${MCP_CONSOLE_TEST_POLL_DYLIB:?}"
: "${MCP_CONSOLE_TEST_POLL_LOADED_NAME:?}"
: "${MCP_CONSOLE_TEST_POLL_ARM_NAME:?}"
: "${MCP_CONSOLE_TEST_POLL_SIDEBAND_READY_NAME:?}"
: "${MCP_CONSOLE_TEST_POLL_CANCEL_READY_NAME:?}"

export MCP_CONSOLE_TEST_POLL_PID="$$"
export MCP_CONSOLE_TEST_POLL_LOADED="$TMPDIR/$MCP_CONSOLE_TEST_POLL_LOADED_NAME"
export MCP_CONSOLE_TEST_POLL_ARM="$TMPDIR/$MCP_CONSOLE_TEST_POLL_ARM_NAME"
export MCP_CONSOLE_TEST_POLL_SIDEBAND_READY="$TMPDIR/$MCP_CONSOLE_TEST_POLL_SIDEBAND_READY_NAME"
export MCP_CONSOLE_TEST_POLL_CANCEL_READY="$TMPDIR/$MCP_CONSOLE_TEST_POLL_CANCEL_READY_NAME"
case "$(uname -s)" in
  Darwin) export DYLD_INSERT_LIBRARIES="$MCP_CONSOLE_TEST_POLL_DYLIB" ;;
  Linux) export LD_PRELOAD="$MCP_CONSOLE_TEST_POLL_DYLIB" ;;
esac

exec "$MCP_CONSOLE_TEST_RELAY_BINARY" worker-relay "$@"
