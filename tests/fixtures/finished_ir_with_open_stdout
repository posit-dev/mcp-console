#!/usr/bin/env python3

import os
import subprocess
import sys
from pathlib import Path


if sys.argv[1:] == ["--version"]:
    print("ir 0.4.0")
elif sys.argv[1:] == ["hold"]:
    with open(os.environ["MCP_CONSOLE_TEST_IR_HOLDER_RELEASE"], "rb", buffering=0) as release:
        assert release.read(1) == b"1"
else:
    assert sys.argv[1] == "run", sys.argv
    holder = subprocess.Popen(
        [sys.executable, __file__, "hold"],
        stdin=subprocess.DEVNULL,
        stdout=sys.stdout,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    Path(os.environ["MCP_CONSOLE_TEST_IR_HOLDER_PID"]).write_text(str(holder.pid))
    Path(os.environ["MCP_CONSOLE_TEST_IR_PID"]).write_text(str(os.getpid()))
    sys.stdout.write(os.environ["MCP_CONSOLE_TEST_IR_LIBRARY"])
    sys.stdout.flush()
    with open(os.environ["MCP_CONSOLE_TEST_IR_STARTED"], "wb", buffering=0) as started:
        assert started.write(b"1") == 1
    with open(os.environ["MCP_CONSOLE_TEST_IR_RELEASE"], "rb", buffering=0) as release:
        assert release.read(1) == b"1"
