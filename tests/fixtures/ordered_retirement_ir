#!/usr/bin/env python3

import os
import signal
import sys
from pathlib import Path


def notify(path: str) -> None:
    with Path(path).open("wb", buffering=0) as checkpoint:
        checkpoint.write(b"1")


def wait(path: str) -> None:
    with Path(path).open("rb", buffering=0) as checkpoint:
        assert checkpoint.read(1) == b"1"


def wait_for_interrupt() -> None:
    signum = signal.sigwait({signal.SIGINT})
    assert signum == signal.SIGINT
    notify(os.environ["MCP_CONSOLE_TEST_IR_INTERRUPTED"])
    if release := os.environ.get("MCP_CONSOLE_TEST_IR_INTERRUPT_RELEASE"):
        wait(release)
    raise SystemExit(128 + signum)


def resolve() -> None:
    interruptible = bool(os.environ.get("MCP_CONSOLE_TEST_IR_INTERRUPTED"))
    if interruptible:
        # Block before readiness so an early SIGINT stays pending for sigwait.
        # A Python callback can remain deferred across a blocking FIFO read.
        previous = signal.pthread_sigmask(signal.SIG_BLOCK, {signal.SIGINT})
        assert signal.SIGINT not in previous
    if failure := os.environ.get("MCP_CONSOLE_TEST_IR_FAILURE"):
        print(failure, file=sys.stderr)
        raise SystemExit(1)

    libraries = os.environ["MCP_CONSOLE_TEST_IR_LIBRARIES"].split(os.pathsep)
    counter = Path(os.environ["MCP_CONSOLE_TEST_IR_COUNTER"])
    index = int(counter.read_text(encoding="utf-8")) if counter.exists() else 0
    assert index < len(libraries), (index, libraries)
    gate_index = os.environ.get("MCP_CONSOLE_TEST_IR_GATE_INDEX")
    gated = gate_index is None or index == int(gate_index)
    if gated:
        if started := os.environ.get("MCP_CONSOLE_TEST_IR_STARTED"):
            notify(started)
        if release_gate := os.environ.get("MCP_CONSOLE_TEST_IR_RELEASE_GATE"):
            wait(release_gate)
        if interruptible:
            wait_for_interrupt()
        elif release := os.environ.get("MCP_CONSOLE_TEST_IR_RELEASE"):
            wait(release)
    counter.write_text(str(index + 1), encoding="utf-8")
    if gated:
        if finished := os.environ.get("MCP_CONSOLE_TEST_IR_FINISHED"):
            notify(finished)
        if finish_release := os.environ.get("MCP_CONSOLE_TEST_IR_FINISH_RELEASE"):
            wait(finish_release)
    print(libraries[index], end="")


def main() -> None:
    if sys.argv[1:] == ["--version"]:
        print("ir 0.4.0")
        return
    assert sys.argv[1] == "run", sys.argv
    resolve()


if __name__ == "__main__":
    main()
